{
  "manifest_version": 3,
  "name": "Link Saver",
  "version": "1.0",
  "description": "Uma extensão simples para salvar e visualizar links de páginas da web.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons": {
    "128": "icon128.png"
  }
}